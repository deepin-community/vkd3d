description: fix byte comparison error in d3d12 tests
author: Michael Gilbert <mgilbert@debian.org>

--- a/tests/d3d12_test_utils.h
+++ b/tests/d3d12_test_utils.h
@@ -53,19 +53,25 @@ static void set_viewport(D3D12_VIEWPORT
     vp->MaxDepth = max_depth;
 }
 
-static bool compare_uint(unsigned int x, unsigned int y, unsigned int max_diff)
+static bool compare_byte(BYTE x, BYTE y, BYTE max_diff)
 {
-    unsigned int diff = x > y ? x - y : y - x;
+    BYTE diff = x > y ? x - y : y - x;
+
+    /* handle off by one wrap around */
+    if (max_diff == 1 && diff == UINT8_MAX)
+    {
+        return true;
+    }
 
     return diff <= max_diff;
 }
 
 static bool compare_color(DWORD c1, DWORD c2, BYTE max_diff)
 {
-    return compare_uint(c1 & 0xff, c2 & 0xff, max_diff)
-            && compare_uint((c1 >> 8) & 0xff, (c2 >> 8) & 0xff, max_diff)
-            && compare_uint((c1 >> 16) & 0xff, (c2 >> 16) & 0xff, max_diff)
-            && compare_uint((c1 >> 24) & 0xff, (c2 >> 24) & 0xff, max_diff);
+    return compare_byte(c1 & 0xff, c2 & 0xff, max_diff)
+            && compare_byte((c1 >> 8) & 0xff, (c2 >> 8) & 0xff, max_diff)
+            && compare_byte((c1 >> 16) & 0xff, (c2 >> 16) & 0xff, max_diff)
+            && compare_byte((c1 >> 24) & 0xff, (c2 >> 24) & 0xff, max_diff);
 }
 
 static D3D12_SHADER_BYTECODE shader_bytecode(const DWORD *code, size_t size)
